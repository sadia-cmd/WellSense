@prefix ws: <http://wellsense.example.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ws:Equipment a owl:Class .
ws:Sensor a owl:Class .
ws:Symptom a owl:Class .
ws:Fault a owl:Class .
ws:Cause a owl:Class .
ws:MaintenanceAction a owl:Class .
ws:SafetyConstraint a owl:Class .
ws:Stakeholder a owl:Class .
ws:KnowledgeSource a owl:Class .
ws:Rule a owl:Class .
ws:Question a owl:Class .
ws:upstreamOf a owl:ObjectProperty ; rdfs:domain ws:Equipment ; rdfs:range ws:Equipment .
ws:locatedAt a owl:ObjectProperty ; rdfs:domain ws:Sensor ; rdfs:range ws:Equipment .
ws:causedBy a owl:ObjectProperty ; rdfs:domain ws:Fault ; rdfs:range ws:Cause .
ws:mitigatedBy a owl:ObjectProperty ; rdfs:domain ws:Fault ; rdfs:range ws:MaintenanceAction .
ws:violates a owl:ObjectProperty ; rdfs:domain ws:MaintenanceAction ; rdfs:range ws:SafetyConstraint .
ws:concludes a owl:ObjectProperty ; rdfs:domain ws:Rule ; rdfs:range ws:Fault .
ws:citesSource a owl:ObjectProperty ; rdfs:domain ws:Rule ; rdfs:range ws:KnowledgeSource .
ws:asksAbout a owl:ObjectProperty ; rdfs:domain ws:Question ; rdfs:range ws:Fault .
ws:certaintyFactor a owl:DatatypeProperty .
ws:condition a owl:DatatypeProperty .
ws:explanation a owl:DatatypeProperty .
ws:severity a owl:DatatypeProperty .
ws:safetyRisk a owl:DatatypeProperty .
ws:cost a owl:DatatypeProperty .
ws:effectiveness a owl:DatatypeProperty .
ws:productionLoss a owl:DatatypeProperty .

ws:RESERVOIR a ws:Equipment ; rdfs:label "Reservoir" ; rdfs:comment "Rock formation that supplies oil, gas and water" .
ws:PDG a ws:Equipment ; rdfs:label "Permanent downhole gauge" ; rdfs:comment "Pressure/temperature gauge deep in the well, below the DHSV" .
ws:DHSV a ws:Equipment ; rdfs:label "Downhole safety valve" ; rdfs:comment "Fail-safe valve in the production tubing, held open hydraulically" .
ws:TUBING a ws:Equipment ; rdfs:label "Production tubing" ; rdfs:comment "Pipe that carries fluid from the reservoir to the seabed" .
ws:XMAS_TREE a ws:Equipment ; rdfs:label "Subsea Christmas tree (TPT)" ; rdfs:comment "Valve assembly on the seabed; carries the TPT pressure/temperature transducer" .
ws:PRODUCTION_LINE a ws:Equipment ; rdfs:label "Production line (flowline + riser)" ; rdfs:comment "Pipe from the subsea tree up to the platform" .
ws:PCK a ws:Equipment ; rdfs:label "Production choke (PCK)" ; rdfs:comment "Topside valve that controls the well's flow" .
ws:PLATFORM a ws:Equipment ; rdfs:label "Platform process plant" ; rdfs:comment "Separators and processing downstream of the choke" .
ws:GLCK a ws:Equipment ; rdfs:label "Gas-lift choke (GLCK)" ; rdfs:comment "Topside valve controlling gas-lift injection" .
ws:SERVICE_LINE a ws:Equipment ; rdfs:label "Service line" ; rdfs:comment "Line from the platform to the well used for gas lift and operations" .
ws:ANNULUS a ws:Equipment ; rdfs:label "Well annulus" ; rdfs:comment "Space between tubing and casing; gas-lift gas travels down here" .
ws:RESERVOIR ws:upstreamOf ws:PDG .
ws:PDG ws:upstreamOf ws:DHSV .
ws:DHSV ws:upstreamOf ws:TUBING .
ws:TUBING ws:upstreamOf ws:XMAS_TREE .
ws:XMAS_TREE ws:upstreamOf ws:PRODUCTION_LINE .
ws:PRODUCTION_LINE ws:upstreamOf ws:PCK .
ws:PCK ws:upstreamOf ws:PLATFORM .
ws:P_PDG a ws:Sensor ; rdfs:label "P-PDG" ; ws:locatedAt ws:PDG .
ws:T_PDG a ws:Sensor ; rdfs:label "T-PDG" ; ws:locatedAt ws:PDG .
ws:P_TPT a ws:Sensor ; rdfs:label "P-TPT" ; ws:locatedAt ws:XMAS_TREE .
ws:T_TPT a ws:Sensor ; rdfs:label "T-TPT" ; ws:locatedAt ws:XMAS_TREE .
ws:P_MON_CKP a ws:Sensor ; rdfs:label "P-MON-CKP" ; ws:locatedAt ws:PCK .
ws:T_JUS_CKP a ws:Sensor ; rdfs:label "T-JUS-CKP" ; ws:locatedAt ws:PCK .
ws:T_MON_CKP a ws:Sensor ; rdfs:label "T-MON-CKP" ; ws:locatedAt ws:PCK .
ws:P_JUS_CKP a ws:Sensor ; rdfs:label "P-JUS-CKP" ; ws:locatedAt ws:PCK .
ws:ABER_CKP a ws:Sensor ; rdfs:label "ABER-CKP" ; ws:locatedAt ws:PCK .
ws:P_JUS_CKGL a ws:Sensor ; rdfs:label "P-JUS-CKGL" ; ws:locatedAt ws:GLCK .
ws:P_MON_CKGL a ws:Sensor ; rdfs:label "P-MON-CKGL" ; ws:locatedAt ws:GLCK .
ws:ABER_CKGL a ws:Sensor ; rdfs:label "ABER-CKGL" ; ws:locatedAt ws:GLCK .
ws:QGL a ws:Sensor ; rdfs:label "QGL" ; ws:locatedAt ws:SERVICE_LINE .
ws:P_ANULAR a ws:Sensor ; rdfs:label "P-ANULAR" ; ws:locatedAt ws:ANNULUS .
ws:ESTADO_DHSV a ws:Sensor ; rdfs:label "ESTADO-DHSV" ; ws:locatedAt ws:DHSV .
ws:ABRUPT_INCREASE_OF_BSW a ws:Fault ; rdfs:label "Abrupt increase of BSW" ; ws:severity 3 ; rdfs:comment "Sudden rise in the fraction of water and sediment in the produced liquid." .
ws:SPURIOUS_CLOSURE_OF_DHSV a ws:Fault ; rdfs:label "Spurious closure of DHSV" ; ws:severity 4 ; rdfs:comment "The downhole safety valve closes by itself, usually without any surface indication; production stops." .
ws:SEVERE_SLUGGING a ws:Fault ; rdfs:label "Severe slugging" ; ws:severity 4 ; rdfs:comment "Periodic, intense flow instability detectable along the whole production circuit; can stress or damage equipment." .
ws:FLOW_INSTABILITY a ws:Fault ; rdfs:label "Flow instability" ; ws:severity 2 ; rdfs:comment "Non-periodic, tolerable flow disturbances that can evolve into severe slugging." .
ws:RAPID_PRODUCTIVITY_LOSS a ws:Fault ; rdfs:label "Rapid productivity loss" ; ws:severity 3 ; rdfs:comment "System energy no longer overcomes losses; flow declines and natural flow can be lost." .
ws:QUICK_RESTRICTION_IN_PCK a ws:Fault ; rdfs:label "Quick restriction in PCK" ; ws:severity 2 ; rdfs:comment "Fast, unwanted restriction of the production choke caused by operational problems." .
ws:SCALING_IN_PCK a ws:Fault ; rdfs:label "Scaling in PCK" ; ws:severity 3 ; rdfs:comment "Inorganic deposits build up in the production choke and gradually restrict flow." .
ws:HYDRATE_IN_PRODUCTION_LINE a ws:Fault ; rdfs:label "Hydrate in production line" ; ws:severity 5 ; rdfs:comment "Ice-like water–gas crystals form at high pressure and low temperature and can block the production line." .
ws:HYDRATE_IN_SERVICE_LINE a ws:Fault ; rdfs:label "Hydrate in service line" ; ws:severity 4 ; rdfs:comment "Hydrate blockage in the service (gas-lift) line." .
ws:C_WATER a ws:Cause ; rdfs:label "Water breakthrough (aquifer or injected water reaches the well)" .
ws:ABRUPT_INCREASE_OF_BSW ws:causedBy ws:C_WATER .
ws:C_DHSV_FAIL a ws:Cause ; rdfs:label "DHSV or its hydraulic actuator fails and closes the valve with no surface command" .
ws:SPURIOUS_CLOSURE_OF_DHSV ws:causedBy ws:C_DHSV_FAIL .
ws:C_RISER_LIQ a ws:Cause ; rdfs:label "Liquid accumulates at the riser base, then is pushed out by gas in cycles" .
ws:SEVERE_SLUGGING ws:causedBy ws:C_RISER_LIQ .
ws:C_FLOW_DIST a ws:Cause ; rdfs:label "Gas–liquid flow disturbances without a regular cycle" .
ws:FLOW_INSTABILITY ws:causedBy ws:C_FLOW_DIST .
ws:C_RES_ENERGY a ws:Cause ; rdfs:label "Reservoir properties change (pressure, BSW, GOR, viscosity) so energy no longer overcomes losses" .
ws:RAPID_PRODUCTIVITY_LOSS ws:causedBy ws:C_RES_ENERGY .
ws:C_CHOKE_OP a ws:Cause ; rdfs:label "Operational problem closes the production choke unintentionally" .
ws:QUICK_RESTRICTION_IN_PCK ws:causedBy ws:C_CHOKE_OP .
ws:C_SCALE a ws:Cause ; rdfs:label "Inorganic deposits (scale) form in the choke" .
ws:SCALING_IN_PCK ws:causedBy ws:C_SCALE .
ws:C_HYD_PL a ws:Cause ; rdfs:label "Water and gas at high pressure and low temperature form hydrate crystals in the production line" .
ws:HYDRATE_IN_PRODUCTION_LINE ws:causedBy ws:C_HYD_PL .
ws:C_HYD_SL a ws:Cause ; rdfs:label "Water and gas at high pressure and low temperature form hydrate crystals in the service line" .
ws:HYDRATE_IN_SERVICE_LINE ws:causedBy ws:C_HYD_SL .
ws:SC_HYD_ONESIDE a ws:SafetyConstraint ; rdfs:label "Never depressurize a hydrate plug from one side only — a pressure difference across a released plug turns it into a projectile that can rupture the line." .
ws:SC_HYD_HEAT a ws:SafetyConstraint ; rdfs:label "Never heat the middle of a hydrate plug — released gas can be trapped and rupture the pipe." .
ws:SC_DHSV_EQUALIZE a ws:SafetyConstraint ; rdfs:label "Never force a closed DHSV open against a pressure difference — equalize pressure across the valve first, then reopen through its control system." .
ws:SC_SLUG_IGNORE a ws:SafetyConstraint ; rdfs:label "Do not keep producing through sustained severe slugging without mitigation — it stresses and can damage well and plant equipment." .
ws:SC_SENSOR a ws:SafetyConstraint ; rdfs:label "Do not base a well-integrity decision on a sensor flagged as frozen or failed." .
ws:A_DHSV_1 a ws:MaintenanceAction ; rdfs:label "Equalize pressure across the DHSV, then reopen it through its hydraulic control line (corrective operating procedure)." ; ws:safetyRisk 2 ; ws:productionLoss 1 ; ws:cost 1 ; ws:effectiveness 5 .
ws:SPURIOUS_CLOSURE_OF_DHSV ws:mitigatedBy ws:A_DHSV_1 .
ws:A_DHSV_2 a ws:MaintenanceAction ; rdfs:label "Keep the well closed and schedule a DHSV inspection / workover." ; ws:safetyRisk 1 ; ws:productionLoss 5 ; ws:cost 5 ; ws:effectiveness 4 .
ws:SPURIOUS_CLOSURE_OF_DHSV ws:mitigatedBy ws:A_DHSV_2 .
ws:A_DHSV_3 a ws:MaintenanceAction ; rdfs:label "Force the DHSV open by raising control-line pressure without equalizing." ; ws:safetyRisk 5 ; ws:productionLoss 1 ; ws:cost 1 ; ws:effectiveness 3 .
ws:SPURIOUS_CLOSURE_OF_DHSV ws:mitigatedBy ws:A_DHSV_3 .
ws:A_DHSV_3 ws:violates ws:SC_DHSV_EQUALIZE .
ws:A_BSW_1 a ws:MaintenanceAction ; rdfs:label "Confirm with a fluid sample, then adjust choke / gas-lift to the new operating point." ; ws:safetyRisk 1 ; ws:productionLoss 2 ; ws:cost 1 ; ws:effectiveness 3 .
ws:ABRUPT_INCREASE_OF_BSW ws:mitigatedBy ws:A_BSW_1 .
ws:A_BSW_2 a ws:MaintenanceAction ; rdfs:label "Inform the reservoir team; review water injection and plan water shut-off." ; ws:safetyRisk 1 ; ws:productionLoss 3 ; ws:cost 4 ; ws:effectiveness 4 .
ws:ABRUPT_INCREASE_OF_BSW ws:mitigatedBy ws:A_BSW_2 .
ws:A_BSW_3 a ws:MaintenanceAction ; rdfs:label "Continue unchanged and only monitor." ; ws:safetyRisk 2 ; ws:productionLoss 4 ; ws:cost 1 ; ws:effectiveness 1 .
ws:ABRUPT_INCREASE_OF_BSW ws:mitigatedBy ws:A_BSW_3 .
ws:A_SLUG_1 a ws:MaintenanceAction ; rdfs:label "Choke back the production choke to stabilise the flow." ; ws:safetyRisk 1 ; ws:productionLoss 3 ; ws:cost 1 ; ws:effectiveness 4 .
ws:SEVERE_SLUGGING ws:mitigatedBy ws:A_SLUG_1 .
ws:A_SLUG_2 a ws:MaintenanceAction ; rdfs:label "Increase gas-lift injection to lighten the riser column." ; ws:safetyRisk 2 ; ws:productionLoss 2 ; ws:cost 2 ; ws:effectiveness 3 .
ws:SEVERE_SLUGGING ws:mitigatedBy ws:A_SLUG_2 .
ws:A_SLUG_3 a ws:MaintenanceAction ; rdfs:label "Switch on active (feedback) slug control on the production choke." ; ws:safetyRisk 1 ; ws:productionLoss 1 ; ws:cost 3 ; ws:effectiveness 5 .
ws:SEVERE_SLUGGING ws:mitigatedBy ws:A_SLUG_3 .
ws:A_SLUG_4 a ws:MaintenanceAction ; rdfs:label "Ignore it and keep producing at full rate." ; ws:safetyRisk 4 ; ws:productionLoss 1 ; ws:cost 1 ; ws:effectiveness 1 .
ws:SEVERE_SLUGGING ws:mitigatedBy ws:A_SLUG_4 .
ws:A_SLUG_4 ws:violates ws:SC_SLUG_IGNORE .
ws:A_INST_1 a ws:MaintenanceAction ; rdfs:label "Watch closely and make a small choke adjustment to restore stable flow." ; ws:safetyRisk 1 ; ws:productionLoss 2 ; ws:cost 1 ; ws:effectiveness 3 .
ws:FLOW_INSTABILITY ws:mitigatedBy ws:A_INST_1 .
ws:A_INST_2 a ws:MaintenanceAction ; rdfs:label "Adjust the gas-lift rate to a more stable operating point." ; ws:safetyRisk 1 ; ws:productionLoss 2 ; ws:cost 1 ; ws:effectiveness 3 .
ws:FLOW_INSTABILITY ws:mitigatedBy ws:A_INST_2 .
ws:A_PL_1 a ws:MaintenanceAction ; rdfs:label "Change the operating point (open choke / increase gas lift) to keep natural flow." ; ws:safetyRisk 2 ; ws:productionLoss 1 ; ws:cost 1 ; ws:effectiveness 4 .
ws:RAPID_PRODUCTIVITY_LOSS ws:mitigatedBy ws:A_PL_1 .
ws:A_PL_2 a ws:MaintenanceAction ; rdfs:label "Run a well test and update the reservoir model." ; ws:safetyRisk 1 ; ws:productionLoss 3 ; ws:cost 2 ; ws:effectiveness 3 .
ws:RAPID_PRODUCTIVITY_LOSS ws:mitigatedBy ws:A_PL_2 .
ws:A_PL_3 a ws:MaintenanceAction ; rdfs:label "Plan a stimulation or artificial-lift intervention." ; ws:safetyRisk 3 ; ws:productionLoss 2 ; ws:cost 5 ; ws:effectiveness 4 .
ws:RAPID_PRODUCTIVITY_LOSS ws:mitigatedBy ws:A_PL_3 .
ws:A_QR_1 a ws:MaintenanceAction ; rdfs:label "Check the production choke and restore it to its set-point." ; ws:safetyRisk 1 ; ws:productionLoss 1 ; ws:cost 1 ; ws:effectiveness 5 .
ws:QUICK_RESTRICTION_IN_PCK ws:mitigatedBy ws:A_QR_1 .
ws:A_QR_2 a ws:MaintenanceAction ; rdfs:label "Inspect the choke actuator / control system for faults." ; ws:safetyRisk 1 ; ws:productionLoss 2 ; ws:cost 2 ; ws:effectiveness 4 .
ws:QUICK_RESTRICTION_IN_PCK ws:mitigatedBy ws:A_QR_2 .
ws:A_SC_1 a ws:MaintenanceAction ; rdfs:label "Inject scale inhibitor upstream of the choke." ; ws:safetyRisk 2 ; ws:productionLoss 2 ; ws:cost 2 ; ws:effectiveness 4 .
ws:SCALING_IN_PCK ws:mitigatedBy ws:A_SC_1 .
ws:A_SC_2 a ws:MaintenanceAction ; rdfs:label "Dissolve the deposits with a chemical (acid) wash." ; ws:safetyRisk 3 ; ws:productionLoss 3 ; ws:cost 3 ; ws:effectiveness 4 .
ws:SCALING_IN_PCK ws:mitigatedBy ws:A_SC_2 .
ws:A_SC_3 a ws:MaintenanceAction ; rdfs:label "Shut in and clean or replace the choke trim." ; ws:safetyRisk 2 ; ws:productionLoss 4 ; ws:cost 3 ; ws:effectiveness 5 .
ws:SCALING_IN_PCK ws:mitigatedBy ws:A_SC_3 .
ws:A_SC_4 a ws:MaintenanceAction ; rdfs:label "Open the choke further to compensate." ; ws:safetyRisk 2 ; ws:productionLoss 1 ; ws:cost 1 ; ws:effectiveness 2 .
ws:SCALING_IN_PCK ws:mitigatedBy ws:A_SC_4 .
ws:A_HPL_1 a ws:MaintenanceAction ; rdfs:label "Depressurize the line slowly from BOTH sides of the plug, then let the hydrate dissociate." ; ws:safetyRisk 2 ; ws:productionLoss 4 ; ws:cost 2 ; ws:effectiveness 4 .
ws:HYDRATE_IN_PRODUCTION_LINE ws:mitigatedBy ws:A_HPL_1 .
ws:A_HPL_2 a ws:MaintenanceAction ; rdfs:label "Bring coiled tubing to place inhibitor (MEG/methanol) at the plug face." ; ws:safetyRisk 3 ; ws:productionLoss 3 ; ws:cost 5 ; ws:effectiveness 4 .
ws:HYDRATE_IN_PRODUCTION_LINE ws:mitigatedBy ws:A_HPL_2 .
ws:A_HPL_3 a ws:MaintenanceAction ; rdfs:label "Increase hydrate-inhibitor dosing while the line still flows." ; ws:safetyRisk 1 ; ws:productionLoss 2 ; ws:cost 2 ; ws:effectiveness 3 .
ws:HYDRATE_IN_PRODUCTION_LINE ws:mitigatedBy ws:A_HPL_3 .
ws:A_HPL_4 a ws:MaintenanceAction ; rdfs:label "Depressurize from one side only to clear the plug faster." ; ws:safetyRisk 5 ; ws:productionLoss 2 ; ws:cost 1 ; ws:effectiveness 3 .
ws:HYDRATE_IN_PRODUCTION_LINE ws:mitigatedBy ws:A_HPL_4 .
ws:A_HPL_4 ws:violates ws:SC_HYD_ONESIDE .
ws:A_HPL_5 a ws:MaintenanceAction ; rdfs:label "Heat the line at the middle of the plug." ; ws:safetyRisk 5 ; ws:productionLoss 2 ; ws:cost 2 ; ws:effectiveness 3 .
ws:HYDRATE_IN_PRODUCTION_LINE ws:mitigatedBy ws:A_HPL_5 .
ws:A_HPL_5 ws:violates ws:SC_HYD_HEAT .
ws:A_HSL_1 a ws:MaintenanceAction ; rdfs:label "Depressurize the service line from both sides and inject inhibitor." ; ws:safetyRisk 2 ; ws:productionLoss 3 ; ws:cost 2 ; ws:effectiveness 4 .
ws:HYDRATE_IN_SERVICE_LINE ws:mitigatedBy ws:A_HSL_1 .
ws:A_HSL_2 a ws:MaintenanceAction ; rdfs:label "Stop gas lift through the blocked line and produce without it meanwhile." ; ws:safetyRisk 1 ; ws:productionLoss 3 ; ws:cost 1 ; ws:effectiveness 3 .
ws:HYDRATE_IN_SERVICE_LINE ws:mitigatedBy ws:A_HSL_2 .
ws:A_HSL_3 a ws:MaintenanceAction ; rdfs:label "Raise gas-lift pressure to blow the plug through." ; ws:safetyRisk 5 ; ws:productionLoss 2 ; ws:cost 1 ; ws:effectiveness 2 .
ws:HYDRATE_IN_SERVICE_LINE ws:mitigatedBy ws:A_HSL_3 .
ws:A_HSL_3 ws:violates ws:SC_HYD_ONESIDE .
ws:A_SENS_PDG a ws:MaintenanceAction ; rdfs:label "Schedule a downhole-gauge check; until fixed, base decisions on TPT and choke sensors." ; ws:safetyRisk 1 ; ws:productionLoss 1 ; ws:cost 2 ; ws:effectiveness 3 .
ws:A_SENS_TPT a ws:MaintenanceAction ; rdfs:label "Schedule a subsea transducer (TPT) check." ; ws:safetyRisk 1 ; ws:productionLoss 1 ; ws:cost 3 ; ws:effectiveness 3 .
ws:OPERATOR a ws:Stakeholder ; rdfs:label "Control-room operator" ; rdfs:comment "Fast, clear alarms; few false alarms; simple steps" .
ws:PROD_ENG a ws:Stakeholder ; rdfs:label "Production engineer" ; rdfs:comment "Accurate diagnosis; keep the well producing" .
ws:WELL_INTEGRITY a ws:Stakeholder ; rdfs:label "Well-integrity / maintenance team" ; rdfs:comment "Safe interventions; protect well barriers (DHSV)" .
ws:HSE a ws:Stakeholder ; rdfs:label "HSE (safety) officer" ; rdfs:comment "No unsafe recommendation, ever" .
ws:PROD_MANAGER a ws:Stakeholder ; rdfs:label "Production manager" ; rdfs:comment "Minimise lost production and downtime" .
ws:FINANCE a ws:Stakeholder ; rdfs:label "Asset / finance manager" ; rdfs:comment "Minimise intervention cost (rigs can exceed US$500k/day)" .
ws:RESERVOIR_ENG a ws:Stakeholder ; rdfs:label "Reservoir engineer" ; rdfs:comment "Understand water breakthrough and productivity changes" .
ws:VARGAS2019 a ws:KnowledgeSource ; rdfs:label "Vargas, R.E.V. (2019). Base de dados e benchmarks para prognóstico de anomalias em sistemas de elevação de petróleo. Doctoral thesis, Universidade Federal do Espírito Santo, Sections 2.2–2.4." .
ws:VARGAS2025 a ws:KnowledgeSource ; rdfs:label "Vargas, R.E.V. et al. (2025). 3W Dataset 2.0.0: a realistic and public dataset with rare undesirable real events in oil wells. arXiv:2507.01048." .
ws:PETROBRAS3W a ws:KnowledgeSource ; rdfs:label "Petrobras (2024). 3W Project, dataset v2.0.0 — dataset.ini variable and event definitions. CC BY 4.0." .
ws:PETROWIKI_HYD a ws:KnowledgeSource ; rdfs:label "Society of Petroleum Engineers. Hydrate plug removal. PetroWiki (from the Petroleum Engineering Handbook)." .
ws:SCHMIDT1985 a ws:KnowledgeSource ; rdfs:label "Schmidt, Z., Doty, D.R., Dutta-Roy, K. (1985). Severe slugging in offshore pipeline riser-pipe systems. SPE Journal 25(1), 27–38." .
ws:GODHAVN2005 a ws:KnowledgeSource ; rdfs:label "Godhavn, J.-M., Fard, M.P., Fuchs, P.H. (2005). New slug control strategies, tuning rules and experimental results. Journal of Process Control 15(5), 547–557." .
ws:API14B a ws:KnowledgeSource ; rdfs:label "American Petroleum Institute. API RP 14B — Design, Installation, Operation, Test, and Redress of Subsurface Safety Valve Systems." .
ws:PHYSICS a ws:KnowledgeSource ; rdfs:label "Basic flow physics: a restriction in a flow path raises pressure upstream of it and lowers pressure downstream of it; reduced flow lets fluid cool toward sea temperature." .
ws:DATA_DEV a ws:KnowledgeSource ; rdfs:label "WellSense analysis of the 125 development instances (Notebook 2, Section 3): symptom frequencies after fault onset vs normal operation." .
ws:SHORTLIFFE1975 a ws:KnowledgeSource ; rdfs:label "Shortliffe, E.H., Buchanan, B.G. (1975). A model of inexact reasoning in medicine. Mathematical Biosciences 23(3–4), 351–379." .
ws:Q_DHSV_COMMANDED a ws:Question ; rdfs:label "Was the DHSV closed on purpose (shutdown or ESD command) in the last hour?" ; ws:asksAbout ws:SPURIOUS_CLOSURE_OF_DHSV .
ws:Q_DHSV_HYDRAULICS a ws:Question ; rdfs:label "Is the DHSV hydraulic control-line pressure at its normal value?" ; ws:asksAbout ws:SPURIOUS_CLOSURE_OF_DHSV .
ws:Q_WATER_SAMPLE a ws:Question ; rdfs:label "Does the latest fluid sample show a higher water cut (BSW) than before?" ; ws:asksAbout ws:ABRUPT_INCREASE_OF_BSW .
ws:Q_SEPARATOR_SURGES a ws:Question ; rdfs:label "Are the platform separator levels surging in a regular, repeating cycle?" ; ws:asksAbout ws:SEVERE_SLUGGING ; ws:asksAbout ws:FLOW_INSTABILITY .
ws:Q_SETPOINT_CHANGE a ws:Question ; rdfs:label "Was the production choke or gas-lift rate changed in the last 2 hours?" ; ws:asksAbout ws:FLOW_INSTABILITY ; ws:asksAbout ws:QUICK_RESTRICTION_IN_PCK .
ws:Q_WELL_TEST a ws:Question ; rdfs:label "Did the most recent well test show production below the expected rate?" ; ws:asksAbout ws:RAPID_PRODUCTIVITY_LOSS .
ws:Q_CHOKE_LOCAL a ws:Question ; rdfs:label "Checked on site, is the production choke more closed than its set-point?" ; ws:asksAbout ws:QUICK_RESTRICTION_IN_PCK ; ws:asksAbout ws:SCALING_IN_PCK .
ws:Q_SCALE_HISTORY a ws:Question ; rdfs:label "Has this well had scale deposits before, or does water analysis show a scaling tendency?" ; ws:asksAbout ws:SCALING_IN_PCK .
ws:Q_HYDRATE_CURVE a ws:Question ; rdfs:label "Is the production line inside the hydrate-formation region for its current pressure and temperature?" ; ws:asksAbout ws:HYDRATE_IN_PRODUCTION_LINE ; ws:asksAbout ws:HYDRATE_IN_SERVICE_LINE .
ws:Q_RECENT_RESTART a ws:Question ; rdfs:label "Was the well shut in or restarted during the last 24 hours?" ; ws:asksAbout ws:HYDRATE_IN_PRODUCTION_LINE ; ws:asksAbout ws:HYDRATE_IN_SERVICE_LINE .
ws:Q_SERVICE_LINE_INHIBITOR a ws:Question ; rdfs:label "Was the service line left without hydrate inhibitor (for example after an operation)?" ; ws:asksAbout ws:HYDRATE_IN_SERVICE_LINE .
ws:rule_A_PDG_P_1 a ws:Rule ; rdfs:label "Downhole pressure (PDG) above its normal level" ; ws:condition "p_pdg.level = HIGH" ; ws:certaintyFactor 0.9 ; ws:explanation "Downhole pressure (PDG) is clearly above this well's own baseline (first hour)." ; ws:citesSource ws:DATA_DEV .
ws:rule_A_PDG_P_2 a ws:Rule ; rdfs:label "Downhole pressure (PDG) rising" ; ws:condition "p_pdg.trend = RISING AND NOT p_pdg.level = LOW" ; ws:certaintyFactor 0.7 ; ws:explanation "Downhole pressure (PDG) rose more than the normal 15-minute variation (and is not below normal — a low but recovering reading is not 'up')." ; ws:citesSource ws:DATA_DEV .
ws:rule_A_PDG_P_3 a ws:Rule ; rdfs:label "Downhole pressure (PDG) below its normal level" ; ws:condition "p_pdg.level = LOW" ; ws:certaintyFactor 0.9 ; ws:explanation "Downhole pressure (PDG) is clearly below this well's own baseline (first hour)." ; ws:citesSource ws:DATA_DEV .
ws:rule_A_PDG_P_4 a ws:Rule ; rdfs:label "Downhole pressure (PDG) falling" ; ws:condition "p_pdg.trend = FALLING AND NOT p_pdg.level = HIGH" ; ws:certaintyFactor 0.7 ; ws:explanation "Downhole pressure (PDG) fell more than the normal 15-minute variation (and is not above normal — a high but settling reading is not 'down')." ; ws:citesSource ws:DATA_DEV .
ws:rule_A_TPT_P_1 a ws:Rule ; rdfs:label "Subsea tree pressure (TPT) above its normal level" ; ws:condition "p_tpt.level = HIGH" ; ws:certaintyFactor 0.9 ; ws:explanation "Subsea tree pressure (TPT) is clearly above this well's own baseline (first hour)." ; ws:citesSource ws:DATA_DEV .
ws:rule_A_TPT_P_2 a ws:Rule ; rdfs:label "Subsea tree pressure (TPT) rising" ; ws:condition "p_tpt.trend = RISING AND NOT p_tpt.level = LOW" ; ws:certaintyFactor 0.7 ; ws:explanation "Subsea tree pressure (TPT) rose more than the normal 15-minute variation (and is not below normal — a low but recovering reading is not 'up')." ; ws:citesSource ws:DATA_DEV .
ws:rule_A_TPT_P_3 a ws:Rule ; rdfs:label "Subsea tree pressure (TPT) below its normal level" ; ws:condition "p_tpt.level = LOW" ; ws:certaintyFactor 0.9 ; ws:explanation "Subsea tree pressure (TPT) is clearly below this well's own baseline (first hour)." ; ws:citesSource ws:DATA_DEV .
ws:rule_A_TPT_P_4 a ws:Rule ; rdfs:label "Subsea tree pressure (TPT) falling" ; ws:condition "p_tpt.trend = FALLING AND NOT p_tpt.level = HIGH" ; ws:certaintyFactor 0.7 ; ws:explanation "Subsea tree pressure (TPT) fell more than the normal 15-minute variation (and is not above normal — a high but settling reading is not 'down')." ; ws:citesSource ws:DATA_DEV .
ws:rule_A_CKP_P_1 a ws:Rule ; rdfs:label "Pressure upstream of production choke above its normal level" ; ws:condition "p_mon_ckp.level = HIGH" ; ws:certaintyFactor 0.9 ; ws:explanation "Pressure upstream of production choke is clearly above this well's own baseline (first hour)." ; ws:citesSource ws:DATA_DEV .
ws:rule_A_CKP_P_2 a ws:Rule ; rdfs:label "Pressure upstream of production choke rising" ; ws:condition "p_mon_ckp.trend = RISING AND NOT p_mon_ckp.level = LOW" ; ws:certaintyFactor 0.7 ; ws:explanation "Pressure upstream of production choke rose more than the normal 15-minute variation (and is not below normal — a low but recovering reading is not 'up')." ; ws:citesSource ws:DATA_DEV .
ws:rule_A_CKP_P_3 a ws:Rule ; rdfs:label "Pressure upstream of production choke below its normal level" ; ws:condition "p_mon_ckp.level = LOW" ; ws:certaintyFactor 0.9 ; ws:explanation "Pressure upstream of production choke is clearly below this well's own baseline (first hour)." ; ws:citesSource ws:DATA_DEV .
ws:rule_A_CKP_P_4 a ws:Rule ; rdfs:label "Pressure upstream of production choke falling" ; ws:condition "p_mon_ckp.trend = FALLING AND NOT p_mon_ckp.level = HIGH" ; ws:certaintyFactor 0.7 ; ws:explanation "Pressure upstream of production choke fell more than the normal 15-minute variation (and is not above normal — a high but settling reading is not 'down')." ; ws:citesSource ws:DATA_DEV .
ws:rule_A_TPT_T_1 a ws:Rule ; rdfs:label "Subsea tree temperature (TPT) above its normal level" ; ws:condition "t_tpt.level = HIGH" ; ws:certaintyFactor 0.9 ; ws:explanation "Subsea tree temperature (TPT) is clearly above this well's own baseline (first hour)." ; ws:citesSource ws:DATA_DEV .
ws:rule_A_TPT_T_2 a ws:Rule ; rdfs:label "Subsea tree temperature (TPT) rising" ; ws:condition "t_tpt.trend = RISING AND NOT t_tpt.level = LOW" ; ws:certaintyFactor 0.7 ; ws:explanation "Subsea tree temperature (TPT) rose more than the normal 15-minute variation (and is not below normal — a low but recovering reading is not 'up')." ; ws:citesSource ws:DATA_DEV .
ws:rule_A_TPT_T_3 a ws:Rule ; rdfs:label "Subsea tree temperature (TPT) below its normal level" ; ws:condition "t_tpt.level = LOW" ; ws:certaintyFactor 0.9 ; ws:explanation "Subsea tree temperature (TPT) is clearly below this well's own baseline (first hour)." ; ws:citesSource ws:DATA_DEV .
ws:rule_A_TPT_T_4 a ws:Rule ; rdfs:label "Subsea tree temperature (TPT) falling" ; ws:condition "t_tpt.trend = FALLING AND NOT t_tpt.level = HIGH" ; ws:certaintyFactor 0.7 ; ws:explanation "Subsea tree temperature (TPT) fell more than the normal 15-minute variation (and is not above normal — a high but settling reading is not 'down')." ; ws:citesSource ws:DATA_DEV .
ws:rule_A_CKP_T_1 a ws:Rule ; rdfs:label "Temperature downstream of production choke above its normal level" ; ws:condition "t_jus_ckp.level = HIGH" ; ws:certaintyFactor 0.9 ; ws:explanation "Temperature downstream of production choke is clearly above this well's own baseline (first hour)." ; ws:citesSource ws:DATA_DEV .
ws:rule_A_CKP_T_2 a ws:Rule ; rdfs:label "Temperature downstream of production choke rising" ; ws:condition "t_jus_ckp.trend = RISING AND NOT t_jus_ckp.level = LOW" ; ws:certaintyFactor 0.7 ; ws:explanation "Temperature downstream of production choke rose more than the normal 15-minute variation (and is not below normal — a low but recovering reading is not 'up')." ; ws:citesSource ws:DATA_DEV .
ws:rule_A_CKP_T_3 a ws:Rule ; rdfs:label "Temperature downstream of production choke below its normal level" ; ws:condition "t_jus_ckp.level = LOW" ; ws:certaintyFactor 0.9 ; ws:explanation "Temperature downstream of production choke is clearly below this well's own baseline (first hour)." ; ws:citesSource ws:DATA_DEV .
ws:rule_A_CKP_T_4 a ws:Rule ; rdfs:label "Temperature downstream of production choke falling" ; ws:condition "t_jus_ckp.trend = FALLING AND NOT t_jus_ckp.level = HIGH" ; ws:certaintyFactor 0.7 ; ws:explanation "Temperature downstream of production choke fell more than the normal 15-minute variation (and is not above normal — a high but settling reading is not 'down')." ; ws:citesSource ws:DATA_DEV .
ws:rule_A_PDG_T_1 a ws:Rule ; rdfs:label "Downhole temperature (PDG) above its normal level" ; ws:condition "t_pdg.level = HIGH" ; ws:certaintyFactor 0.9 ; ws:explanation "Downhole temperature (PDG) is clearly above this well's own baseline (first hour)." ; ws:citesSource ws:DATA_DEV .
ws:rule_A_PDG_T_2 a ws:Rule ; rdfs:label "Downhole temperature (PDG) rising" ; ws:condition "t_pdg.trend = RISING AND NOT t_pdg.level = LOW" ; ws:certaintyFactor 0.7 ; ws:explanation "Downhole temperature (PDG) rose more than the normal 15-minute variation (and is not below normal — a low but recovering reading is not 'up')." ; ws:citesSource ws:DATA_DEV .
ws:rule_A_PDG_T_3 a ws:Rule ; rdfs:label "Downhole temperature (PDG) below its normal level" ; ws:condition "t_pdg.level = LOW" ; ws:certaintyFactor 0.9 ; ws:explanation "Downhole temperature (PDG) is clearly below this well's own baseline (first hour)." ; ws:citesSource ws:DATA_DEV .
ws:rule_A_PDG_T_4 a ws:Rule ; rdfs:label "Downhole temperature (PDG) falling" ; ws:condition "t_pdg.trend = FALLING AND NOT t_pdg.level = HIGH" ; ws:certaintyFactor 0.7 ; ws:explanation "Downhole temperature (PDG) fell more than the normal 15-minute variation (and is not above normal — a high but settling reading is not 'down')." ; ws:citesSource ws:DATA_DEV .
ws:rule_A_ANN_P_1 a ws:Rule ; rdfs:label "Annulus pressure above its normal level" ; ws:condition "p_anular.level = HIGH" ; ws:certaintyFactor 0.9 ; ws:explanation "Annulus pressure is clearly above this well's own baseline (first hour)." ; ws:citesSource ws:DATA_DEV .
ws:rule_A_ANN_P_2 a ws:Rule ; rdfs:label "Annulus pressure rising" ; ws:condition "p_anular.trend = RISING AND NOT p_anular.level = LOW" ; ws:certaintyFactor 0.7 ; ws:explanation "Annulus pressure rose more than the normal 15-minute variation (and is not below normal — a low but recovering reading is not 'up')." ; ws:citesSource ws:DATA_DEV .
ws:rule_A_ANN_P_3 a ws:Rule ; rdfs:label "Annulus pressure below its normal level" ; ws:condition "p_anular.level = LOW" ; ws:certaintyFactor 0.9 ; ws:explanation "Annulus pressure is clearly below this well's own baseline (first hour)." ; ws:citesSource ws:DATA_DEV .
ws:rule_A_ANN_P_4 a ws:Rule ; rdfs:label "Annulus pressure falling" ; ws:condition "p_anular.trend = FALLING AND NOT p_anular.level = HIGH" ; ws:certaintyFactor 0.7 ; ws:explanation "Annulus pressure fell more than the normal 15-minute variation (and is not above normal — a high but settling reading is not 'down')." ; ws:citesSource ws:DATA_DEV .
ws:rule_A_GL_P_1 a ws:Rule ; rdfs:label "Gas-lift pressure downstream of GLCK above its normal level" ; ws:condition "p_jus_ckgl.level = HIGH" ; ws:certaintyFactor 0.9 ; ws:explanation "Gas-lift pressure downstream of GLCK is clearly above this well's own baseline (first hour)." ; ws:citesSource ws:DATA_DEV .
ws:rule_A_GL_P_2 a ws:Rule ; rdfs:label "Gas-lift pressure downstream of GLCK rising" ; ws:condition "p_jus_ckgl.trend = RISING AND NOT p_jus_ckgl.level = LOW" ; ws:certaintyFactor 0.7 ; ws:explanation "Gas-lift pressure downstream of GLCK rose more than the normal 15-minute variation (and is not below normal — a low but recovering reading is not 'up')." ; ws:citesSource ws:DATA_DEV .
ws:rule_A_GL_P_3 a ws:Rule ; rdfs:label "Gas-lift pressure downstream of GLCK below its normal level" ; ws:condition "p_jus_ckgl.level = LOW" ; ws:certaintyFactor 0.9 ; ws:explanation "Gas-lift pressure downstream of GLCK is clearly below this well's own baseline (first hour)." ; ws:citesSource ws:DATA_DEV .
ws:rule_A_GL_P_4 a ws:Rule ; rdfs:label "Gas-lift pressure downstream of GLCK falling" ; ws:condition "p_jus_ckgl.trend = FALLING AND NOT p_jus_ckgl.level = HIGH" ; ws:certaintyFactor 0.7 ; ws:explanation "Gas-lift pressure downstream of GLCK fell more than the normal 15-minute variation (and is not above normal — a high but settling reading is not 'down')." ; ws:citesSource ws:DATA_DEV .
ws:rule_A_GL_FLOW_1 a ws:Rule ; rdfs:label "Gas-lift flow above its normal level" ; ws:condition "qgl.level = HIGH" ; ws:certaintyFactor 0.9 ; ws:explanation "Gas-lift flow is clearly above this well's own baseline (first hour)." ; ws:citesSource ws:DATA_DEV .
ws:rule_A_GL_FLOW_2 a ws:Rule ; rdfs:label "Gas-lift flow rising" ; ws:condition "qgl.trend = RISING AND NOT qgl.level = LOW" ; ws:certaintyFactor 0.7 ; ws:explanation "Gas-lift flow rose more than the normal 15-minute variation (and is not below normal — a low but recovering reading is not 'up')." ; ws:citesSource ws:DATA_DEV .
ws:rule_A_GL_FLOW_3 a ws:Rule ; rdfs:label "Gas-lift flow below its normal level" ; ws:condition "qgl.level = LOW" ; ws:certaintyFactor 0.9 ; ws:explanation "Gas-lift flow is clearly below this well's own baseline (first hour)." ; ws:citesSource ws:DATA_DEV .
ws:rule_A_GL_FLOW_4 a ws:Rule ; rdfs:label "Gas-lift flow falling" ; ws:condition "qgl.trend = FALLING AND NOT qgl.level = HIGH" ; ws:certaintyFactor 0.7 ; ws:explanation "Gas-lift flow fell more than the normal 15-minute variation (and is not above normal — a high but settling reading is not 'down')." ; ws:citesSource ws:DATA_DEV .
ws:rule_A_TPT_CYCLE_L a ws:Rule ; rdfs:label "Large repeated swings in p_tpt" ; ws:condition "p_tpt.cycle = LARGE" ; ws:certaintyFactor 0.9 ; ws:explanation "p_tpt went up and down repeatedly in the last 2 hours with a swing above the 'large' size (10 bar for main pressures)." ; ws:citesSource ws:VARGAS2025 ; ws:citesSource ws:DATA_DEV .
ws:rule_A_TPT_CYCLE_S a ws:Rule ; rdfs:label "Small repeated swings in p_tpt" ; ws:condition "p_tpt.cycle = SMALL" ; ws:certaintyFactor 0.8 ; ws:explanation "p_tpt went up and down repeatedly in the last 2 hours, but with a small swing." ; ws:citesSource ws:DATA_DEV .
ws:rule_A_CKP_CYCLE_L a ws:Rule ; rdfs:label "Large repeated swings in p_mon_ckp" ; ws:condition "p_mon_ckp.cycle = LARGE" ; ws:certaintyFactor 0.9 ; ws:explanation "p_mon_ckp went up and down repeatedly in the last 2 hours with a swing above the 'large' size (10 bar for main pressures)." ; ws:citesSource ws:VARGAS2025 ; ws:citesSource ws:DATA_DEV .
ws:rule_A_CKP_CYCLE_S a ws:Rule ; rdfs:label "Small repeated swings in p_mon_ckp" ; ws:condition "p_mon_ckp.cycle = SMALL" ; ws:certaintyFactor 0.8 ; ws:explanation "p_mon_ckp went up and down repeatedly in the last 2 hours, but with a small swing." ; ws:citesSource ws:DATA_DEV .
ws:rule_A_PDG_CYCLE_L a ws:Rule ; rdfs:label "Large repeated swings in p_pdg" ; ws:condition "p_pdg.cycle = LARGE" ; ws:certaintyFactor 0.9 ; ws:explanation "p_pdg went up and down repeatedly in the last 2 hours with a swing above the 'large' size (10 bar for main pressures)." ; ws:citesSource ws:VARGAS2025 ; ws:citesSource ws:DATA_DEV .
ws:rule_A_PDG_CYCLE_S a ws:Rule ; rdfs:label "Small repeated swings in p_pdg" ; ws:condition "p_pdg.cycle = SMALL" ; ws:certaintyFactor 0.8 ; ws:explanation "p_pdg went up and down repeatedly in the last 2 hours, but with a small swing." ; ws:citesSource ws:DATA_DEV .
ws:rule_A_TPT_T_CYCLE_L a ws:Rule ; rdfs:label "Large repeated swings in t_tpt" ; ws:condition "t_tpt.cycle = LARGE" ; ws:certaintyFactor 0.9 ; ws:explanation "t_tpt went up and down repeatedly in the last 2 hours with a swing above the 'large' size (10 bar for main pressures)." ; ws:citesSource ws:VARGAS2025 ; ws:citesSource ws:DATA_DEV .
ws:rule_A_TPT_T_CYCLE_S a ws:Rule ; rdfs:label "Small repeated swings in t_tpt" ; ws:condition "t_tpt.cycle = SMALL" ; ws:certaintyFactor 0.8 ; ws:explanation "t_tpt went up and down repeatedly in the last 2 hours, but with a small swing." ; ws:citesSource ws:DATA_DEV .
ws:rule_A_ANN_CYCLE_L a ws:Rule ; rdfs:label "Large repeated swings in p_anular" ; ws:condition "p_anular.cycle = LARGE" ; ws:certaintyFactor 0.9 ; ws:explanation "p_anular went up and down repeatedly in the last 2 hours with a swing above the 'large' size (10 bar for main pressures)." ; ws:citesSource ws:VARGAS2025 ; ws:citesSource ws:DATA_DEV .
ws:rule_A_ANN_CYCLE_S a ws:Rule ; rdfs:label "Small repeated swings in p_anular" ; ws:condition "p_anular.cycle = SMALL" ; ws:certaintyFactor 0.8 ; ws:explanation "p_anular went up and down repeatedly in the last 2 hours, but with a small swing." ; ws:citesSource ws:DATA_DEV .
ws:rule_A_GL_CYCLE_L a ws:Rule ; rdfs:label "Large repeated swings in p_jus_ckgl" ; ws:condition "p_jus_ckgl.cycle = LARGE" ; ws:certaintyFactor 0.9 ; ws:explanation "p_jus_ckgl went up and down repeatedly in the last 2 hours with a swing above the 'large' size (10 bar for main pressures)." ; ws:citesSource ws:VARGAS2025 ; ws:citesSource ws:DATA_DEV .
ws:rule_A_GL_CYCLE_S a ws:Rule ; rdfs:label "Small repeated swings in p_jus_ckgl" ; ws:condition "p_jus_ckgl.cycle = SMALL" ; ws:certaintyFactor 0.8 ; ws:explanation "p_jus_ckgl went up and down repeatedly in the last 2 hours, but with a small swing." ; ws:citesSource ws:DATA_DEV .
ws:rule_A_CKP_P_DRIFT_U a ws:Rule ; rdfs:label "Slow upward drift of p_mon_ckp over 3 hours" ; ws:condition "p_mon_ckp.drift = RISING" ; ws:certaintyFactor 0.85 ; ws:explanation "p_mon_ckp has crept up over the last 3 hours by more than normal wells ever drift." ; ws:citesSource ws:DATA_DEV .
ws:rule_A_CKP_P_DRIFT_D a ws:Rule ; rdfs:label "Slow downward drift of p_mon_ckp over 3 hours" ; ws:condition "p_mon_ckp.drift = FALLING" ; ws:certaintyFactor 0.85 ; ws:explanation "p_mon_ckp has crept down over the last 3 hours by more than normal wells ever drift." ; ws:citesSource ws:DATA_DEV .
ws:rule_A_TPT_P_DRIFT_U a ws:Rule ; rdfs:label "Slow upward drift of p_tpt over 3 hours" ; ws:condition "p_tpt.drift = RISING" ; ws:certaintyFactor 0.85 ; ws:explanation "p_tpt has crept up over the last 3 hours by more than normal wells ever drift." ; ws:citesSource ws:DATA_DEV .
ws:rule_A_TPT_P_DRIFT_D a ws:Rule ; rdfs:label "Slow downward drift of p_tpt over 3 hours" ; ws:condition "p_tpt.drift = FALLING" ; ws:certaintyFactor 0.85 ; ws:explanation "p_tpt has crept down over the last 3 hours by more than normal wells ever drift." ; ws:citesSource ws:DATA_DEV .
ws:rule_A_CKP_T_DRIFT_U a ws:Rule ; rdfs:label "Slow upward drift of t_jus_ckp over 3 hours" ; ws:condition "t_jus_ckp.drift = RISING" ; ws:certaintyFactor 0.85 ; ws:explanation "t_jus_ckp has crept up over the last 3 hours by more than normal wells ever drift." ; ws:citesSource ws:DATA_DEV .
ws:rule_A_CKP_T_DRIFT_D a ws:Rule ; rdfs:label "Slow downward drift of t_jus_ckp over 3 hours" ; ws:condition "t_jus_ckp.drift = FALLING" ; ws:certaintyFactor 0.85 ; ws:explanation "t_jus_ckp has crept down over the last 3 hours by more than normal wells ever drift." ; ws:citesSource ws:DATA_DEV .
ws:rule_A_GL_P_DRIFT_U a ws:Rule ; rdfs:label "Slow upward drift of p_jus_ckgl over 3 hours" ; ws:condition "p_jus_ckgl.drift = RISING" ; ws:certaintyFactor 0.85 ; ws:explanation "p_jus_ckgl has crept up over the last 3 hours by more than normal wells ever drift." ; ws:citesSource ws:DATA_DEV .
ws:rule_A_GL_P_DRIFT_D a ws:Rule ; rdfs:label "Slow downward drift of p_jus_ckgl over 3 hours" ; ws:condition "p_jus_ckgl.drift = FALLING" ; ws:certaintyFactor 0.85 ; ws:explanation "p_jus_ckgl has crept down over the last 3 hours by more than normal wells ever drift." ; ws:citesSource ws:DATA_DEV .
ws:rule_A_CKP_JUMP_N a ws:Rule ; rdfs:label "No sudden change before the choke" ; ws:condition "p_mon_ckp.jump30 = NONE" ; ws:certaintyFactor 0.8 ; ws:explanation "No sudden P-MON-CKP change in the last 30 minutes." ; ws:citesSource ws:DATA_DEV .
ws:rule_A_TPT_JUMP_D a ws:Rule ; rdfs:label "Sudden drop of subsea pressure" ; ws:condition "p_tpt.jump30 = JUMP_DOWN/BOTH" ; ws:certaintyFactor 0.9 ; ws:explanation "P-TPT dropped suddenly within the last 30 minutes (fast event)." ; ws:citesSource ws:DATA_DEV .
ws:rule_A_TPT_JUMP_U a ws:Rule ; rdfs:label "Sudden rise of subsea pressure" ; ws:condition "p_tpt.jump30 = JUMP_UP/BOTH" ; ws:certaintyFactor 0.9 ; ws:explanation "P-TPT rose suddenly within the last 30 minutes (fast event)." ; ws:citesSource ws:DATA_DEV .
ws:rule_A_TPT_JUMP_N a ws:Rule ; rdfs:label "No sudden change of subsea pressure" ; ws:condition "p_tpt.jump30 = NONE" ; ws:certaintyFactor 0.8 ; ws:explanation "No sudden P-TPT change in the last 30 minutes (slow event or none)." ; ws:citesSource ws:DATA_DEV .
ws:rule_A_CHOKE_C a ws:Rule ; rdfs:label "Production choke closing" ; ws:condition "aber_ckp.trend = CLOSING" ; ws:certaintyFactor 0.95 ; ws:explanation "The recorded opening of the production choke decreased." ; ws:citesSource ws:PETROBRAS3W .
ws:rule_A_CHOKE_S a ws:Rule ; rdfs:label "Production choke opening unchanged" ; ws:condition "aber_ckp.trend = STABLE" ; ws:certaintyFactor 0.9 ; ws:explanation "The recorded opening of the production choke has not changed." ; ws:citesSource ws:PETROBRAS3W .
ws:rule_A_GASLIFT a ws:Rule ; rdfs:label "Gas lift in operation" ; ws:condition "gas_lift = ON" ; ws:certaintyFactor 1.0 ; ws:explanation "Gas-lift flow is above zero." ; ws:citesSource ws:PETROBRAS3W .
ws:rule_X_SHUTIN a ws:Rule ; rdfs:label "Well deliberately closed" ; ws:condition "well_state = Shut-In/Closed With Diesel/Closed With Gas" ; ws:certaintyFactor 1.0 ; ws:explanation "Petrobras state label says the well is deliberately closed, so stopped flow is expected." ; ws:citesSource ws:VARGAS2025 .
ws:rule_X_RESTART a ws:Rule ; rdfs:label "Well being restarted" ; ws:condition "well_state = Restart" ; ws:certaintyFactor 1.0 ; ws:explanation "The well is being restarted — cold fluid and changing pressures are expected (and hydrates are more likely)." ; ws:citesSource ws:VARGAS2025 .
ws:rule_X_INTERV a ws:Rule ; rdfs:label "Well intervention in progress" ; ws:condition "well_state = Flushing Diesel/Flushing Gas/Bullheading/Depressurization" ; ws:certaintyFactor 1.0 ; ws:explanation "An operation is changing pressures on purpose." ; ws:citesSource ws:VARGAS2025 .
ws:rule_X_COVERAGE a ws:Rule ; rdfs:label "Too few trustworthy sensors to diagnose" ; ws:condition "DATA_COVERAGE = LOW" ; ws:certaintyFactor 1.0 ; ws:explanation "Fewer than 2 of the 8 key process sensors give trustworthy readings right now. Instead of guessing 'normal', the system reports that it cannot decide (incomplete information)." ; ws:citesSource ws:VARGAS2019 .
ws:rule_V_PDG_FROZEN a ws:Rule ; rdfs:label "Downhole gauge frozen while subsea pressure changes" ; ws:condition "p_pdg.quality = FROZEN AND TPT_P = UP/DOWN" ; ws:certaintyFactor 1.0 ; ws:explanation "P-PDG has reported exactly the same value for over an hour while the reliable TPT sensor shows a real change. The two disagree; the thesis notes PDGs commonly freeze or fail, while TPT is considered reliable, so PDG is discounted (trust 0.2)." ; ws:citesSource ws:VARGAS2019 .
ws:rule_V_PDG_FAIL a ws:Rule ; rdfs:label "Downhole gauge sending invalid values" ; ws:condition "p_pdg.quality = INVALID" ; ws:certaintyFactor 1.0 ; ws:explanation "P-PDG is sending error codes or impossible values; diagnosis must rely on TPT and choke sensors." ; ws:citesSource ws:VARGAS2019 .
ws:rule_V_TPT_FROZEN a ws:Rule ; rdfs:label "Subsea transducer frozen" ; ws:condition "p_tpt.quality = FROZEN" ; ws:certaintyFactor 1.0 ; ws:explanation "P-TPT has reported exactly the same value for over an hour." ; ws:citesSource ws:VARGAS2019 .
ws:rule_S_FLOWSTOP_1 a ws:Rule ; rdfs:label "Flow stopping: subsea fluid cooling" ; ws:condition "TPT_T = DOWN" ; ws:certaintyFactor 0.7 ; ws:explanation "When production stops, the fluid at the subsea tree cools toward sea temperature (the thesis notes T-TPT decay indicates production stopped)." ; ws:citesSource ws:VARGAS2019 ; ws:citesSource ws:PHYSICS .
ws:rule_S_FLOWSTOP_2 a ws:Rule ; rdfs:label "Flow stopping: choke outlet cooling" ; ws:condition "CKP_T = DOWN" ; ws:certaintyFactor 0.5 ; ws:explanation "Less hot fluid passes the choke, so the temperature after it falls." ; ws:citesSource ws:PHYSICS .
ws:rule_S_TEMPUP_1 a ws:Rule ; rdfs:label "Fluid temperatures rising (TPT)" ; ws:condition "TPT_T = UP" ; ws:certaintyFactor 0.6 ; ws:explanation "Warmer fluid at the subsea tree." ; ws:citesSource ws:VARGAS2019 .
ws:rule_S_TEMPUP_2 a ws:Rule ; rdfs:label "Fluid temperatures rising (after choke)" ; ws:condition "CKP_T = UP" ; ws:certaintyFactor 0.6 ; ws:explanation "Warmer fluid after the production choke." ; ws:citesSource ws:VARGAS2019 .
ws:rule_S_HYDCOND a ws:Rule ; rdfs:label "Hydrate-favourable conditions" ; ws:condition "TPT_P = UP AND TPT_T = DOWN" ; ws:certaintyFactor 0.7 ; ws:explanation "Hydrates need high pressure and low temperature: pressure at the tree is up while temperature is down." ; ws:citesSource ws:VARGAS2019 ; ws:citesSource ws:PETROWIKI_HYD .
ws:rule_S_OSC_TPT_CYCLE a ws:Rule ; rdfs:label "Flow is oscillating (TPT_CYCLE large swings)" ; ws:condition "TPT_CYCLE = LARGE" ; ws:certaintyFactor 0.9 ; ws:explanation "Large repeated swings mean the flow itself is oscillating. While it oscillates, momentary ups and downs of pressure say nothing about WHERE a blockage is, so the location rules are switched off." ; ws:citesSource ws:VARGAS2019 ; ws:citesSource ws:PHYSICS .
ws:rule_S_OSC_CKP_CYCLE a ws:Rule ; rdfs:label "Flow is oscillating (CKP_CYCLE large swings)" ; ws:condition "CKP_CYCLE = LARGE" ; ws:certaintyFactor 0.7 ; ws:explanation "Large repeated swings mean the flow itself is oscillating. While it oscillates, momentary ups and downs of pressure say nothing about WHERE a blockage is, so the location rules are switched off." ; ws:citesSource ws:VARGAS2019 ; ws:citesSource ws:PHYSICS .
ws:rule_S_OSC_TPT_T_CYCLE a ws:Rule ; rdfs:label "Flow is oscillating (TPT_T_CYCLE large swings)" ; ws:condition "TPT_T_CYCLE = LARGE" ; ws:certaintyFactor 0.6 ; ws:explanation "Large repeated swings mean the flow itself is oscillating. While it oscillates, momentary ups and downs of pressure say nothing about WHERE a blockage is, so the location rules are switched off." ; ws:citesSource ws:VARGAS2019 ; ws:citesSource ws:PHYSICS .
ws:rule_L_DHSV_1 a ws:Rule ; rdfs:label "Restriction between downhole gauge and subsea tree" ; ws:condition "NOT OSC_FLOW = YES AND PDG_P = UP AND TPT_P = DOWN" ; ws:certaintyFactor 0.9 ; ws:explanation "Pressure rises below and falls above the DHSV: something is blocking flow between the PDG and the TPT — where the DHSV sits." ; ws:citesSource ws:PHYSICS ; ws:citesSource ws:VARGAS2025 .
ws:rule_L_DHSV_2 a ws:Rule ; rdfs:label "Restriction near DHSV (downhole gauge unavailable)" ; ws:condition "NOT OSC_FLOW = YES AND TPT_P = DOWN AND CKP_P = DOWN AND TPT_JUMP = DOWN AND NOT PDG_P = UP" ; ws:certaintyFactor 0.6 ; ws:explanation "Works without the PDG: pressure dropped suddenly at the tree and before the choke, so the blockage is below the tree." ; ws:citesSource ws:PHYSICS ; ws:citesSource ws:VARGAS2025 .
ws:rule_L_DHSV_3 a ws:Rule ; rdfs:label "Restriction near DHSV (only subsea tree sensors available)" ; ws:condition "NOT OSC_FLOW = YES AND TPT_P = DOWN AND TPT_JUMP = DOWN AND FLOW = STOPPING AND NOT PDG_P = UP AND NOT CKP_P = UP" ; ws:certaintyFactor 0.55 ; ws:explanation "Works with the subsea tree alone: pressure fell suddenly and the fluid is cooling (flow stopping), so something closed below the tree." ; ws:citesSource ws:PHYSICS ; ws:citesSource ws:VARGAS2019 .
ws:rule_L_PL_1 a ws:Rule ; rdfs:label "Restriction between subsea tree and production choke" ; ws:condition "NOT OSC_FLOW = YES AND TPT_P = UP AND CKP_P = DOWN" ; ws:certaintyFactor 0.85 ; ws:explanation "Pressure rises at the subsea tree but falls before the choke: the blockage is in the production line between them." ; ws:citesSource ws:PHYSICS ; ws:citesSource ws:VARGAS2025 .
ws:rule_L_PL_2 a ws:Rule ; rdfs:label "Restriction above the subsea tree (choke pressure unavailable)" ; ws:condition "NOT OSC_FLOW = YES AND PDG_P = UP AND TPT_P = UP AND NOT CKP_P = UP AND NOT TPT_CYCLE = LARGE" ; ws:certaintyFactor 0.5 ; ws:explanation "Pressure rises both downhole and at the tree, with no rise before the choke: the blockage is downstream of the tree." ; ws:citesSource ws:PHYSICS .
ws:rule_L_CK_1 a ws:Rule ; rdfs:label "Restriction at the production choke" ; ws:condition "NOT OSC_FLOW = YES AND TPT_P = UP AND CKP_P = UP" ; ws:certaintyFactor 0.8 ; ws:explanation "Pressure rises everywhere upstream of the choke: the blockage is at the choke itself." ; ws:citesSource ws:PHYSICS ; ws:citesSource ws:VARGAS2025 .
ws:rule_L_CK_2 a ws:Rule ; rdfs:label "Restriction at the choke (pressure up, outlet cooling)" ; ws:condition "NOT OSC_FLOW = YES AND CKP_P = UP AND CKP_T = DOWN" ; ws:certaintyFactor 0.6 ; ws:explanation "Pressure builds before the choke while less fluid passes it (outlet cools)." ; ws:citesSource ws:PHYSICS .
ws:rule_L_GL_1 a ws:Rule ; rdfs:label "Restriction in the gas-lift/service line" ; ws:condition "NOT OSC_FLOW = YES AND GL_P = UP AND GL_FLOW = DOWN" ; ws:certaintyFactor 0.85 ; ws:explanation "Gas-lift pressure rises after the gas-lift choke while the gas-lift flow falls: the service line is blocked." ; ws:citesSource ws:PHYSICS .
ws:rule_L_GL_2 a ws:Rule ; rdfs:label "Restriction in service line (annulus side)" ; ws:condition "NOT OSC_FLOW = YES AND GL_P = UP AND ANN_P = DOWN" ; ws:certaintyFactor 0.6 ; ws:explanation "Pressure rises before the blockage (gas-lift side) and falls after it (annulus)." ; ws:citesSource ws:PHYSICS .
ws:rule_D_DHSV_1 a ws:Rule ; rdfs:label "Spurious DHSV closure (restriction at DHSV + flow stopping)" ; ws:condition "RESTRICTION = DHSV_ZONE AND FLOW = STOPPING" ; ws:certaintyFactor 0.85 ; ws:explanation "A blockage at the DHSV with production stopping is the signature of a spurious DHSV closure." ; ws:concludes ws:SPURIOUS_CLOSURE_OF_DHSV ; ws:citesSource ws:VARGAS2019 ; ws:citesSource ws:VARGAS2025 .
ws:rule_D_DHSV_2 a ws:Rule ; rdfs:label "Spurious DHSV closure (restriction at DHSV)" ; ws:condition "RESTRICTION = DHSV_ZONE" ; ws:certaintyFactor 0.6 ; ws:explanation "The pressure pattern places the blockage at the DHSV." ; ws:concludes ws:SPURIOUS_CLOSURE_OF_DHSV ; ws:citesSource ws:VARGAS2025 .
ws:rule_D_DHSV_N a ws:Rule ; rdfs:label "Against DHSV closure: temperatures rising" ; ws:condition "TEMPS = UP" ; ws:certaintyFactor -0.4 ; ws:explanation "A closed DHSV stops flow, which cools the fluid — rising temperatures argue against it." ; ws:concludes ws:SPURIOUS_CLOSURE_OF_DHSV ; ws:citesSource ws:PHYSICS .
ws:rule_D_BSW_1 a ws:Rule ; rdfs:label "Abrupt BSW increase (surface pressure down, temperatures up)" ; ws:condition "NOT OSC_FLOW = YES AND TPT_P = DOWN AND TEMPS = UP" ; ws:certaintyFactor 0.7 ; ws:explanation "Thesis rule: with more water, pressures near the surface fall and temperatures rise (water carries more heat)." ; ws:concludes ws:ABRUPT_INCREASE_OF_BSW ; ws:citesSource ws:VARGAS2019 .
ws:rule_D_BSW_2 a ws:Rule ; rdfs:label "Abrupt BSW increase (deep pressure up, surface down, temperatures up)" ; ws:condition "NOT OSC_FLOW = YES AND PDG_P = UP AND TPT_P = DOWN AND TEMPS = UP" ; ws:certaintyFactor 0.8 ; ws:explanation "Thesis rule: deeper pressures rise, near-surface pressures fall, temperatures rise." ; ws:concludes ws:ABRUPT_INCREASE_OF_BSW ; ws:citesSource ws:VARGAS2019 .
ws:rule_D_BSW_3 a ws:Rule ; rdfs:label "Abrupt BSW increase (gradual surface pressure decline, flow continues)" ; ws:condition "NOT OSC_FLOW = YES AND TPT_P = DOWN AND CKP_P = DOWN AND NOT FLOW = STOPPING AND NOT TPT_JUMP = DOWN AND NOT ANN_P = DOWN" ; ws:certaintyFactor 0.45 ; ws:explanation "Surface pressures drift down while fluid keeps flowing and the annulus is unaffected — heavier (wetter) fluid column." ; ws:concludes ws:ABRUPT_INCREASE_OF_BSW ; ws:citesSource ws:VARGAS2019 ; ws:citesSource ws:DATA_DEV .
ws:rule_D_BSW_N a ws:Rule ; rdfs:label "Against BSW: flow stopping" ; ws:condition "FLOW = STOPPING" ; ws:certaintyFactor -0.5 ; ws:explanation "A BSW increase changes the fluid but does not stop the flow." ; ws:concludes ws:ABRUPT_INCREASE_OF_BSW ; ws:citesSource ws:VARGAS2019 .
ws:rule_D_SLUG_1 a ws:Rule ; rdfs:label "Severe slugging (large swings along the circuit)" ; ws:condition "TPT_CYCLE = LARGE AND CKP_CYCLE = LARGE" ; ws:certaintyFactor 0.9 ; ws:explanation "Large, repeated swings at both the subsea tree and the choke: severe slugging is detectable along the whole production circuit." ; ws:concludes ws:SEVERE_SLUGGING ; ws:citesSource ws:VARGAS2019 ; ws:citesSource ws:VARGAS2025 ; ws:citesSource ws:SCHMIDT1985 .
ws:rule_D_SLUG_2 a ws:Rule ; rdfs:label "Severe slugging (large swings at subsea tree)" ; ws:condition "TPT_CYCLE = LARGE" ; ws:certaintyFactor 0.7 ; ws:explanation "The 3W paper shows slugging as swings above 10 bar at the TPT." ; ws:concludes ws:SEVERE_SLUGGING ; ws:citesSource ws:VARGAS2025 .
ws:rule_D_SLUG_3 a ws:Rule ; rdfs:label "Severe slugging (large swings before choke and in temperature)" ; ws:condition "CKP_CYCLE = LARGE AND TPT_T_CYCLE = LARGE" ; ws:certaintyFactor 0.7 ; ws:explanation "Large repeated swings in choke pressure and subsea temperature together." ; ws:concludes ws:SEVERE_SLUGGING ; ws:citesSource ws:VARGAS2019 ; ws:citesSource ws:DATA_DEV .
ws:rule_D_SLUG_5 a ws:Rule ; rdfs:label "Severe slugging (large swings in annulus and gas lift)" ; ws:condition "ANN_CYCLE = LARGE AND GL_CYCLE = LARGE" ; ws:certaintyFactor 0.5 ; ws:explanation "The slug cycle also shows in the annulus and gas-lift pressures." ; ws:concludes ws:SEVERE_SLUGGING ; ws:citesSource ws:DATA_DEV .
ws:rule_D_INST_1 a ws:Rule ; rdfs:label "Flow instability (small swings at subsea tree)" ; ws:condition "TPT_CYCLE = SMALL" ; ws:certaintyFactor 0.6 ; ws:explanation "Tolerable, non-periodic swings in the subsea pressure." ; ws:concludes ws:FLOW_INSTABILITY ; ws:citesSource ws:VARGAS2019 ; ws:citesSource ws:DATA_DEV .
ws:rule_D_INST_2 a ws:Rule ; rdfs:label "Flow instability (small swings at tree and choke)" ; ws:condition "TPT_CYCLE = SMALL AND CKP_CYCLE = SMALL" ; ws:certaintyFactor 0.75 ; ws:explanation "Small swings in two places along the flow path." ; ws:concludes ws:FLOW_INSTABILITY ; ws:citesSource ws:VARGAS2019 ; ws:citesSource ws:DATA_DEV .
ws:rule_D_INST_3 a ws:Rule ; rdfs:label "Flow instability (small swings before choke)" ; ws:condition "CKP_CYCLE = SMALL AND NOT RESTRICTION = DHSV_ZONE/PRODUCTION_LINE/CHOKE" ; ws:certaintyFactor 0.35 ; ws:explanation "Small swings before the choke only — weak evidence (normal wells sometimes show this)." ; ws:concludes ws:FLOW_INSTABILITY ; ws:citesSource ws:DATA_DEV .
ws:rule_D_INST_N a ws:Rule ; rdfs:label "Against instability: swings are large (that is slugging)" ; ws:condition "TPT_CYCLE = LARGE" ; ws:certaintyFactor -0.6 ; ws:explanation "Large repeated swings mean severe slugging rather than tolerable instability." ; ws:concludes ws:FLOW_INSTABILITY ; ws:citesSource ws:VARGAS2019 .
ws:rule_D_PL_1 a ws:Rule ; rdfs:label "Rapid productivity loss (annulus and subsea pressures fall)" ; ws:condition "NOT OSC_FLOW = YES AND ANN_P = DOWN AND TPT_P = DOWN AND NOT RESTRICTION = DHSV_ZONE AND NOT TPT_JUMP = DOWN" ; ws:certaintyFactor 0.7 ; ws:explanation "The whole system loses pressure (energy) without a blockage: the reservoir can no longer push fluid up." ; ws:concludes ws:RAPID_PRODUCTIVITY_LOSS ; ws:citesSource ws:VARGAS2019 ; ws:citesSource ws:DATA_DEV .
ws:rule_D_PL_2 a ws:Rule ; rdfs:label "Rapid productivity loss (pressures and temperature falling, no blockage)" ; ws:condition "NOT OSC_FLOW = YES AND TPT_P = DOWN AND CKP_P = DOWN AND TPT_T = DOWN AND NOT RESTRICTION = DHSV_ZONE AND NOT TPT_JUMP = DOWN" ; ws:certaintyFactor 0.6 ; ws:explanation "Pressures and temperature decline gradually along the circuit, with no sudden drop and no blockage pattern." ; ws:concludes ws:RAPID_PRODUCTIVITY_LOSS ; ws:citesSource ws:VARGAS2019 .
ws:rule_D_PL_N a ws:Rule ; rdfs:label "Against productivity loss: sudden drop" ; ws:condition "TPT_JUMP = DOWN" ; ws:certaintyFactor -0.4 ; ws:explanation "Productivity loss develops over hours; a sudden drop points to a valve closure." ; ws:concludes ws:RAPID_PRODUCTIVITY_LOSS ; ws:citesSource ws:VARGAS2019 .
ws:rule_D_QR_1 a ws:Rule ; rdfs:label "Quick restriction in PCK (choke closing + pressure up before choke)" ; ws:condition "RESTRICTION = CHOKE AND CHOKE_OPENING = CLOSING" ; ws:certaintyFactor 0.85 ; ws:explanation "The choke is closing and pressure builds up before it." ; ws:concludes ws:QUICK_RESTRICTION_IN_PCK ; ws:citesSource ws:VARGAS2019 ; ws:citesSource ws:VARGAS2025 .
ws:rule_D_QR_2 a ws:Rule ; rdfs:label "Quick restriction in PCK (sudden rise before the choke)" ; ws:condition "RESTRICTION = CHOKE AND TPT_JUMP = UP" ; ws:certaintyFactor 0.7 ; ws:explanation "A blockage at the choke that appeared suddenly." ; ws:concludes ws:QUICK_RESTRICTION_IN_PCK ; ws:citesSource ws:VARGAS2019 ; ws:citesSource ws:VARGAS2025 .
ws:rule_D_QR_3 a ws:Rule ; rdfs:label "Quick restriction in PCK (subsea pressure up, no blockage elsewhere)" ; ws:condition "NOT OSC_FLOW = YES AND TPT_P = UP AND NOT CKP_P = DOWN AND NOT PDG_P = DOWN AND NOT TPT_CYCLE = LARGE AND NOT FLOW = STOPPING AND NOT RESTRICTION = PRODUCTION_LINE" ; ws:certaintyFactor 0.4 ; ws:explanation "3W paper: a PCK restriction raises pressure at TPT, PDG and before the choke; flow continues." ; ws:concludes ws:QUICK_RESTRICTION_IN_PCK ; ws:citesSource ws:VARGAS2025 ; ws:citesSource ws:DATA_DEV .
ws:rule_D_SC_1 a ws:Rule ; rdfs:label "Scaling in PCK (restriction at choke, choke not moved)" ; ws:condition "RESTRICTION = CHOKE AND CHOKE_OPENING = STABLE" ; ws:certaintyFactor 0.7 ; ws:explanation "Flow is restricted at the choke although nobody moved it — deposits are narrowing it." ; ws:concludes ws:SCALING_IN_PCK ; ws:citesSource ws:VARGAS2019 ; ws:citesSource ws:PHYSICS .
ws:rule_D_SC_2 a ws:Rule ; rdfs:label "Scaling in PCK (pressure before choke up, outlet cooler, no sudden change)" ; ws:condition "NOT OSC_FLOW = YES AND CKP_P = UP AND CKP_T = DOWN AND NOT TPT_JUMP = UP" ; ws:certaintyFactor 0.6 ; ws:explanation "A slow build-up of pressure before the choke while less fluid passes it." ; ws:concludes ws:SCALING_IN_PCK ; ws:citesSource ws:VARGAS2019 ; ws:citesSource ws:DATA_DEV .
ws:rule_D_SC_3 a ws:Rule ; rdfs:label "Scaling in PCK (slow restriction at choke)" ; ws:condition "RESTRICTION = CHOKE AND NOT TPT_JUMP = UP AND NOT CHOKE_OPENING = CLOSING" ; ws:certaintyFactor 0.5 ; ws:explanation "Experts confirm scaling over ~72 h windows: it develops slowly, without sudden jumps." ; ws:concludes ws:SCALING_IN_PCK ; ws:citesSource ws:VARGAS2019 .
ws:rule_D_SC_4 a ws:Rule ; rdfs:label "Scaling in PCK (pressure before choke above normal)" ; ws:condition "NOT OSC_FLOW = YES AND p_mon_ckp.level = HIGH AND NOT TPT_JUMP = UP AND NOT CKP_CYCLE = LARGE" ; ws:certaintyFactor 0.45 ; ws:explanation "Pressure before the choke has settled above this well's normal level." ; ws:concludes ws:SCALING_IN_PCK ; ws:citesSource ws:DATA_DEV .
ws:rule_D_SC_5 a ws:Rule ; rdfs:label "Scaling in PCK (slow pressure build-up before the choke)" ; ws:condition "NOT OSC_FLOW = YES AND CKP_P_DRIFT = UP AND NOT TPT_JUMP = UP AND NOT CHOKE_OPENING = CLOSING AND NOT FLOW = STOPPING AND NOT TPT_P = DOWN" ; ws:certaintyFactor 0.65 ; ws:explanation "Pressure before the choke creeps up over hours with no sudden change and no operator action on the choke: deposits are slowly narrowing it (experts confirm scaling over ~72 h windows)." ; ws:concludes ws:SCALING_IN_PCK ; ws:citesSource ws:VARGAS2019 ; ws:citesSource ws:PHYSICS ; ws:citesSource ws:DATA_DEV .
ws:rule_D_SC_6 a ws:Rule ; rdfs:label "Scaling in PCK (slow build-up before choke, outlet cooling slowly)" ; ws:condition "NOT OSC_FLOW = YES AND CKP_P_DRIFT = UP AND CKP_T_DRIFT = DOWN" ; ws:certaintyFactor 0.75 ; ws:explanation "Slowly rising pressure before the choke together with a slowly cooling outlet: less and less fluid passes the choke." ; ws:concludes ws:SCALING_IN_PCK ; ws:citesSource ws:VARGAS2019 ; ws:citesSource ws:PHYSICS .
ws:rule_D_SC_N a ws:Rule ; rdfs:label "Against scaling: sudden rise" ; ws:condition "TPT_JUMP = UP" ; ws:certaintyFactor -0.4 ; ws:explanation "Scaling builds up over hours to days, not suddenly." ; ws:concludes ws:SCALING_IN_PCK ; ws:citesSource ws:VARGAS2019 .
ws:rule_D_HPL_1 a ws:Rule ; rdfs:label "Hydrate in production line (restriction in line + flow stopping)" ; ws:condition "RESTRICTION = PRODUCTION_LINE AND FLOW = STOPPING" ; ws:certaintyFactor 0.85 ; ws:explanation "A blockage between the tree and the choke while production stops (T-TPT falling)." ; ws:concludes ws:HYDRATE_IN_PRODUCTION_LINE ; ws:citesSource ws:VARGAS2019 ; ws:citesSource ws:VARGAS2025 .
ws:rule_D_HPL_2 a ws:Rule ; rdfs:label "Hydrate in production line (restriction in line)" ; ws:condition "RESTRICTION = PRODUCTION_LINE" ; ws:certaintyFactor 0.6 ; ws:explanation "3W paper: hydrate raises pressure upstream (PDG, TPT) and lowers it downstream (MON-CKP)." ; ws:concludes ws:HYDRATE_IN_PRODUCTION_LINE ; ws:citesSource ws:VARGAS2025 .
ws:rule_D_HPL_3 a ws:Rule ; rdfs:label "Hydrate in production line (hydrate conditions + restriction)" ; ws:condition "RESTRICTION = PRODUCTION_LINE AND HYDRATE_CONDITIONS = YES" ; ws:certaintyFactor 0.8 ; ws:explanation "High pressure and low temperature at the tree favour hydrate formation." ; ws:concludes ws:HYDRATE_IN_PRODUCTION_LINE ; ws:citesSource ws:VARGAS2019 ; ws:citesSource ws:PETROWIKI_HYD .
ws:rule_D_HPL_4 a ws:Rule ; rdfs:label "Hydrate in production line (deep pressure up, tree cooling)" ; ws:condition "NOT OSC_FLOW = YES AND PDG_P = UP AND TPT_T = DOWN AND NOT TPT_P = DOWN" ; ws:certaintyFactor 0.5 ; ws:explanation "Pressure builds downhole while the tree cools and its pressure does not fall — blockage above the tree." ; ws:concludes ws:HYDRATE_IN_PRODUCTION_LINE ; ws:citesSource ws:VARGAS2019 ; ws:citesSource ws:DATA_DEV .
ws:rule_D_HSL_1 a ws:Rule ; rdfs:label "Hydrate in service line (restriction in service line)" ; ws:condition "RESTRICTION = SERVICE_LINE" ; ws:certaintyFactor 0.8 ; ws:explanation "The gas-lift/service line is blocked." ; ws:concludes ws:HYDRATE_IN_SERVICE_LINE ; ws:citesSource ws:VARGAS2025 ; ws:citesSource ws:PHYSICS .
ws:rule_D_HSL_2 a ws:Rule ; rdfs:label "Hydrate in service line (gas-lift pressure up)" ; ws:condition "NOT OSC_FLOW = YES AND GL_P = UP AND GAS_LIFT = ON AND NOT TPT_CYCLE = LARGE" ; ws:certaintyFactor 0.45 ; ws:explanation "Gas-lift pressure after the choke rises while injecting — the line downstream is harder to push through." ; ws:concludes ws:HYDRATE_IN_SERVICE_LINE ; ws:citesSource ws:DATA_DEV .
ws:rule_D_HSL_3 a ws:Rule ; rdfs:label "Hydrate in service line (gas-lift flow down while injecting)" ; ws:condition "NOT OSC_FLOW = YES AND GL_FLOW = DOWN AND NOT GL_P = DOWN AND NOT TPT_CYCLE = LARGE" ; ws:certaintyFactor 0.45 ; ws:explanation "Gas-lift flow falls without a drop in injection pressure." ; ws:concludes ws:HYDRATE_IN_SERVICE_LINE ; ws:citesSource ws:DATA_DEV .
ws:rule_M_OP_2 a ws:Rule ; rdfs:label "Operation in progress explains the pattern (Spurious closure of DHSV)" ; ws:condition "OPERATION = SHUT_IN/INTERVENTION/RESTART AND FAULT = SPURIOUS_CLOSURE_OF_DHSV" ; ws:certaintyFactor -0.7 ; ws:explanation "Operators are shutting in, restarting or intervening on the well, so pressure and flow changes are expected consequences of the operation, not evidence of this fault." ; ws:concludes ws:SPURIOUS_CLOSURE_OF_DHSV ; ws:citesSource ws:VARGAS2025 .
ws:rule_M_OP_5 a ws:Rule ; rdfs:label "Operation in progress explains the pattern (Rapid productivity loss)" ; ws:condition "OPERATION = SHUT_IN/INTERVENTION/RESTART AND FAULT = RAPID_PRODUCTIVITY_LOSS" ; ws:certaintyFactor -0.6 ; ws:explanation "Operators are shutting in, restarting or intervening on the well, so pressure and flow changes are expected consequences of the operation, not evidence of this fault." ; ws:concludes ws:RAPID_PRODUCTIVITY_LOSS ; ws:citesSource ws:VARGAS2025 .
ws:rule_M_OP_1 a ws:Rule ; rdfs:label "Operation in progress explains the pattern (Abrupt increase of BSW)" ; ws:condition "OPERATION = SHUT_IN/INTERVENTION/RESTART AND FAULT = ABRUPT_INCREASE_OF_BSW" ; ws:certaintyFactor -0.6 ; ws:explanation "Operators are shutting in, restarting or intervening on the well, so pressure and flow changes are expected consequences of the operation, not evidence of this fault." ; ws:concludes ws:ABRUPT_INCREASE_OF_BSW ; ws:citesSource ws:VARGAS2025 .
ws:rule_M_OP_6 a ws:Rule ; rdfs:label "Operation in progress explains the pattern (Quick restriction in PCK)" ; ws:condition "OPERATION = SHUT_IN/INTERVENTION/RESTART AND FAULT = QUICK_RESTRICTION_IN_PCK" ; ws:certaintyFactor -0.5 ; ws:explanation "Operators are shutting in, restarting or intervening on the well, so pressure and flow changes are expected consequences of the operation, not evidence of this fault." ; ws:concludes ws:QUICK_RESTRICTION_IN_PCK ; ws:citesSource ws:VARGAS2025 .
ws:rule_M_OP_7 a ws:Rule ; rdfs:label "Operation in progress explains the pattern (Scaling in PCK)" ; ws:condition "OPERATION = SHUT_IN/INTERVENTION/RESTART AND FAULT = SCALING_IN_PCK" ; ws:certaintyFactor -0.5 ; ws:explanation "Operators are shutting in, restarting or intervening on the well, so pressure and flow changes are expected consequences of the operation, not evidence of this fault." ; ws:concludes ws:SCALING_IN_PCK ; ws:citesSource ws:VARGAS2025 .
ws:rule_M_OP_3 a ws:Rule ; rdfs:label "Operation in progress explains the pattern (Severe slugging)" ; ws:condition "OPERATION = SHUT_IN/INTERVENTION/RESTART AND FAULT = SEVERE_SLUGGING" ; ws:certaintyFactor -0.5 ; ws:explanation "Operators are shutting in, restarting or intervening on the well, so pressure and flow changes are expected consequences of the operation, not evidence of this fault." ; ws:concludes ws:SEVERE_SLUGGING ; ws:citesSource ws:VARGAS2025 .
ws:rule_M_OP_4 a ws:Rule ; rdfs:label "Operation in progress explains the pattern (Flow instability)" ; ws:condition "OPERATION = SHUT_IN/INTERVENTION/RESTART AND FAULT = FLOW_INSTABILITY" ; ws:certaintyFactor -0.5 ; ws:explanation "Operators are shutting in, restarting or intervening on the well, so pressure and flow changes are expected consequences of the operation, not evidence of this fault." ; ws:concludes ws:FLOW_INSTABILITY ; ws:citesSource ws:VARGAS2025 .
ws:rule_M_OP_9 a ws:Rule ; rdfs:label "Operation in progress explains the pattern (Hydrate in service line)" ; ws:condition "OPERATION = SHUT_IN/INTERVENTION/RESTART AND FAULT = HYDRATE_IN_SERVICE_LINE" ; ws:certaintyFactor -0.5 ; ws:explanation "Operators are shutting in, restarting or intervening on the well, so pressure and flow changes are expected consequences of the operation, not evidence of this fault." ; ws:concludes ws:HYDRATE_IN_SERVICE_LINE ; ws:citesSource ws:VARGAS2025 .
ws:rule_M_OP_HYD a ws:Rule ; rdfs:label "Hydrate remediation operation in progress" ; ws:condition "OPERATION = INTERVENTION" ; ws:certaintyFactor 0.4 ; ws:explanation "Depressurization, flushing and bullheading are the standard ways to clear a hydrate plug; such an operation suggests a hydrate is being dealt with. (Context rule — its effect is reported separately in the evaluation.)" ; ws:concludes ws:HYDRATE_IN_PRODUCTION_LINE ; ws:citesSource ws:PETROWIKI_HYD ; ws:citesSource ws:VARGAS2025 .
ws:rule_M_RESTART_HYD a ws:Rule ; rdfs:label "Restart raises hydrate likelihood" ; ws:condition "OPERATION = RESTART AND RESTRICTION = PRODUCTION_LINE/SERVICE_LINE" ; ws:certaintyFactor 0.3 ; ws:explanation "Cold restarts are a classic time for hydrate formation." ; ws:concludes ws:HYDRATE_IN_PRODUCTION_LINE ; ws:citesSource ws:PETROWIKI_HYD .
ws:rule_Q_DHSV_NO a ws:Rule ; rdfs:label "Answer NO to Q_DHSV_COMMANDED" ; ws:condition "FAULT = SPURIOUS_CLOSURE_OF_DHSV AND Q_DHSV_COMMANDED = NO" ; ws:certaintyFactor 0.5 ; ws:explanation "Nobody commanded the closure, so it was spurious." ; ws:concludes ws:SPURIOUS_CLOSURE_OF_DHSV ; ws:citesSource ws:VARGAS2019 .
ws:rule_Q_DHSV_YES a ws:Rule ; rdfs:label "Answer YES to Q_DHSV_COMMANDED" ; ws:condition "FAULT = SPURIOUS_CLOSURE_OF_DHSV AND Q_DHSV_COMMANDED = YES" ; ws:certaintyFactor -0.9 ; ws:explanation "The closure was commanded on purpose — expected, not a fault." ; ws:concludes ws:SPURIOUS_CLOSURE_OF_DHSV ; ws:citesSource ws:VARGAS2019 .
ws:rule_Q_DHSVH_YES a ws:Rule ; rdfs:label "Answer YES to Q_DHSV_HYDRAULICS" ; ws:condition "FAULT = SPURIOUS_CLOSURE_OF_DHSV AND Q_DHSV_HYDRAULICS = YES" ; ws:certaintyFactor 0.3 ; ws:explanation "Spurious closures usually happen with no surface indication (normal control-line pressure)." ; ws:concludes ws:SPURIOUS_CLOSURE_OF_DHSV ; ws:citesSource ws:VARGAS2019 .
ws:rule_Q_BSW_YES a ws:Rule ; rdfs:label "Answer YES to Q_WATER_SAMPLE" ; ws:condition "FAULT = ABRUPT_INCREASE_OF_BSW AND Q_WATER_SAMPLE = YES" ; ws:certaintyFactor 0.7 ; ws:explanation "A sample directly confirms the higher water cut." ; ws:concludes ws:ABRUPT_INCREASE_OF_BSW ; ws:citesSource ws:VARGAS2019 .
ws:rule_Q_BSW_NO a ws:Rule ; rdfs:label "Answer NO to Q_WATER_SAMPLE" ; ws:condition "FAULT = ABRUPT_INCREASE_OF_BSW AND Q_WATER_SAMPLE = NO" ; ws:certaintyFactor -0.7 ; ws:explanation "The sample shows no water-cut increase." ; ws:concludes ws:ABRUPT_INCREASE_OF_BSW ; ws:citesSource ws:VARGAS2019 .
ws:rule_Q_SLUG_YES a ws:Rule ; rdfs:label "Answer YES to Q_SEPARATOR_SURGES" ; ws:condition "FAULT = SEVERE_SLUGGING AND Q_SEPARATOR_SURGES = YES" ; ws:certaintyFactor 0.5 ; ws:explanation "Regular surges at the separator are the classic sign of slugging." ; ws:concludes ws:SEVERE_SLUGGING ; ws:citesSource ws:SCHMIDT1985 .
ws:rule_Q_SLUG_NO a ws:Rule ; rdfs:label "Answer NO to Q_SEPARATOR_SURGES" ; ws:condition "FAULT = SEVERE_SLUGGING AND Q_SEPARATOR_SURGES = NO" ; ws:certaintyFactor -0.4 ; ws:explanation "No regular surges: the swings are not periodic." ; ws:concludes ws:SEVERE_SLUGGING ; ws:citesSource ws:VARGAS2019 .
ws:rule_Q_INST_NO a ws:Rule ; rdfs:label "Answer NO to Q_SEPARATOR_SURGES" ; ws:condition "FAULT = FLOW_INSTABILITY AND Q_SEPARATOR_SURGES = NO" ; ws:certaintyFactor 0.3 ; ws:explanation "Disturbances without a regular cycle point to instability." ; ws:concludes ws:FLOW_INSTABILITY ; ws:citesSource ws:VARGAS2019 .
ws:rule_Q_INST_SP a ws:Rule ; rdfs:label "Answer YES to Q_SETPOINT_CHANGE" ; ws:condition "FAULT = FLOW_INSTABILITY AND Q_SETPOINT_CHANGE = YES" ; ws:certaintyFactor 0.3 ; ws:explanation "A recent set-point change can trigger instability." ; ws:concludes ws:FLOW_INSTABILITY ; ws:citesSource ws:VARGAS2019 .
ws:rule_Q_QR_SP a ws:Rule ; rdfs:label "Answer YES to Q_SETPOINT_CHANGE" ; ws:condition "FAULT = QUICK_RESTRICTION_IN_PCK AND Q_SETPOINT_CHANGE = YES" ; ws:certaintyFactor -0.6 ; ws:explanation "The choke was moved deliberately — an operator action, not an unwanted restriction." ; ws:concludes ws:QUICK_RESTRICTION_IN_PCK ; ws:citesSource ws:VARGAS2019 .
ws:rule_Q_PL_YES a ws:Rule ; rdfs:label "Answer YES to Q_WELL_TEST" ; ws:condition "FAULT = RAPID_PRODUCTIVITY_LOSS AND Q_WELL_TEST = YES" ; ws:certaintyFactor 0.6 ; ws:explanation "The well test confirms the well is producing less than expected." ; ws:concludes ws:RAPID_PRODUCTIVITY_LOSS ; ws:citesSource ws:VARGAS2019 .
ws:rule_Q_QR_YES a ws:Rule ; rdfs:label "Answer YES to Q_CHOKE_LOCAL" ; ws:condition "FAULT = QUICK_RESTRICTION_IN_PCK AND Q_CHOKE_LOCAL = YES" ; ws:certaintyFactor 0.6 ; ws:explanation "The choke is physically more closed than intended." ; ws:concludes ws:QUICK_RESTRICTION_IN_PCK ; ws:citesSource ws:VARGAS2019 .
ws:rule_Q_SC_CHK a ws:Rule ; rdfs:label "Answer NO to Q_CHOKE_LOCAL" ; ws:condition "FAULT = SCALING_IN_PCK AND Q_CHOKE_LOCAL = NO" ; ws:certaintyFactor 0.3 ; ws:explanation "The choke position is correct, so the restriction is inside it (deposits)." ; ws:concludes ws:SCALING_IN_PCK ; ws:citesSource ws:VARGAS2019 .
ws:rule_Q_QR_NO a ws:Rule ; rdfs:label "Answer NO to Q_CHOKE_LOCAL" ; ws:condition "FAULT = QUICK_RESTRICTION_IN_PCK AND Q_CHOKE_LOCAL = NO" ; ws:certaintyFactor -0.5 ; ws:explanation "The choke position is correct." ; ws:concludes ws:QUICK_RESTRICTION_IN_PCK ; ws:citesSource ws:VARGAS2019 .
ws:rule_Q_SC_YES a ws:Rule ; rdfs:label "Answer YES to Q_SCALE_HISTORY" ; ws:condition "FAULT = SCALING_IN_PCK AND Q_SCALE_HISTORY = YES" ; ws:certaintyFactor 0.5 ; ws:explanation "Scaling tends to recur where water chemistry favours it." ; ws:concludes ws:SCALING_IN_PCK ; ws:citesSource ws:VARGAS2019 .
ws:rule_Q_HPL_CURVE a ws:Rule ; rdfs:label "Answer YES to Q_HYDRATE_CURVE" ; ws:condition "FAULT = HYDRATE_IN_PRODUCTION_LINE AND Q_HYDRATE_CURVE = YES" ; ws:certaintyFactor 0.6 ; ws:explanation "Conditions are inside the hydrate-formation region." ; ws:concludes ws:HYDRATE_IN_PRODUCTION_LINE ; ws:citesSource ws:PETROWIKI_HYD .
ws:rule_Q_HPL_NOCURVE a ws:Rule ; rdfs:label "Answer NO to Q_HYDRATE_CURVE" ; ws:condition "FAULT = HYDRATE_IN_PRODUCTION_LINE AND Q_HYDRATE_CURVE = NO" ; ws:certaintyFactor -0.7 ; ws:explanation "Hydrates cannot form outside their pressure–temperature region." ; ws:concludes ws:HYDRATE_IN_PRODUCTION_LINE ; ws:citesSource ws:PETROWIKI_HYD .
ws:rule_Q_HSL_CURVE a ws:Rule ; rdfs:label "Answer YES to Q_HYDRATE_CURVE" ; ws:condition "FAULT = HYDRATE_IN_SERVICE_LINE AND Q_HYDRATE_CURVE = YES" ; ws:certaintyFactor 0.5 ; ws:explanation "Conditions are inside the hydrate-formation region." ; ws:concludes ws:HYDRATE_IN_SERVICE_LINE ; ws:citesSource ws:PETROWIKI_HYD .
ws:rule_Q_HPL_RST a ws:Rule ; rdfs:label "Answer YES to Q_RECENT_RESTART" ; ws:condition "FAULT = HYDRATE_IN_PRODUCTION_LINE AND Q_RECENT_RESTART = YES" ; ws:certaintyFactor 0.3 ; ws:explanation "Shut-ins and cold restarts are a common time for hydrates to form." ; ws:concludes ws:HYDRATE_IN_PRODUCTION_LINE ; ws:citesSource ws:PETROWIKI_HYD .
ws:rule_Q_HSL_RST a ws:Rule ; rdfs:label "Answer YES to Q_RECENT_RESTART" ; ws:condition "FAULT = HYDRATE_IN_SERVICE_LINE AND Q_RECENT_RESTART = YES" ; ws:certaintyFactor 0.2 ; ws:explanation "Shut-ins and cold restarts are a common time for hydrates to form." ; ws:concludes ws:HYDRATE_IN_SERVICE_LINE ; ws:citesSource ws:PETROWIKI_HYD .
ws:rule_Q_HSL_INH a ws:Rule ; rdfs:label "Answer YES to Q_SERVICE_LINE_INHIBITOR" ; ws:condition "FAULT = HYDRATE_IN_SERVICE_LINE AND Q_SERVICE_LINE_INHIBITOR = YES" ; ws:certaintyFactor 0.5 ; ws:explanation "Without inhibitor, water left in the line can turn into hydrate." ; ws:concludes ws:HYDRATE_IN_SERVICE_LINE ; ws:citesSource ws:PETROWIKI_HYD .